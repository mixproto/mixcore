{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mixproto/mixcore/contracts/core-api/v0/state.schema.json",
  "title": "mixcore core API v0: StateListener.OnState(stateJSON)",
  "description": "A snapshot replaces everything the UI holds; a diff lists changes since the previous message. seq grows by one per message; a gap never happens within one Start. Values are the console's, never the UI's.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "seq", "status"],
  "properties": {
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "type": { "enum": ["snapshot", "diff"] },
    "seq": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["stopped", "connecting", "live", "stale"],
      "description": "live: input unlocked. stale: connection lost, last values shown, Apply returns ERR_STALE. connecting: not yet connected since Start/Resume. stopped: Stop or Pause."
    },
    "reason": { "type": "string", "description": "Diagnostic text for logs, never shown to users as is." },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "firmware": { "type": "string" }
      }
    },
    "strips": {
      "type": "array",
      "description": "snapshot only: inputs in order, then main.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "faderDB", "mute", "name"],
        "properties": {
          "kind": { "enum": ["input", "main"] },
          "index": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "faderDB": { "$ref": "common.schema.json#/$defs/level" },
          "mute": { "type": "boolean" }
        }
      }
    },
    "changes": {
      "type": "array",
      "description": "diff only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["param", "value", "origin"],
        "properties": {
          "param": { "$ref": "common.schema.json#/$defs/param" },
          "value": { "$ref": "common.schema.json#/$defs/value" },
          "origin": { "$ref": "common.schema.json#/$defs/origin" }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "snapshot" } } }, "then": { "required": ["strips"] } },
    { "if": { "properties": { "type": { "const": "diff" } } }, "then": { "required": ["changes"] } }
  ]
}
