        "properties": {
          "type": {
            "enum": [
              "setSlipGuard",
              "setShowMode"
            ]
          }
        }
      },
      "then": {
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "boolean"
          }
        },
        "not": {
          "required": [
            "param"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "unlock",
              "relock"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "param": {
            "properties": {
              "field": {
                "const": "gain"
              },
              "strip": {
                "properties": {
                  "kind": {
                    "const": "headamp"
                  }
                }
              }
            }
          }
        },
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "openWall"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "type": {
              "const": "set"
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "typed"
              ]
            },
            {
              "required": [
                "undo"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "type": {
              "enum": [
                "set",
                "undo"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "confirmed"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "undo",
              "watch"
            ]
          }
        }
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "param"
              ]
            }
          },
          {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "setFavourites"
            ]
          }
        }
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "param"
              ]
            }
          },
          {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ],
        "required": [
          "favourites"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "lockShowMode",
              "unlockShowMode"
            ]
          }
        }
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "param"
              ]
            }
          },
          {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ],
        "required": [
          "pin"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "type": {
              "enum": [
                "watch"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "scope"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "type": {
              "enum": [
                "setFavourites"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "favourites"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
